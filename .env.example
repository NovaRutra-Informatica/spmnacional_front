# =========================================================
# SPM Nacional — variáveis de ambiente
#
# Copie para `.env` somente se ele ainda não existir. O `.env` NÃO vai para o git.
# Preserve os segredos existentes ao atualizar o código com git pull.
# Em produção (Cloud Run), estes valores vêm do Secret Manager.
# =========================================================

# ---------- Aplicação ----------
# URL pública, usada em links de e-mail, sitemap e OAuth.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DEPLOYMENT_TARGET="local"

# Portas no host usadas pelo Docker Compose. bun run dev usa 3000 por padrão.
WEB_HOST_PORT="3000"
DEV_HOST_PORT="3001"
# Opcional: URL pública do Docker de desenvolvimento. Vazio usa localhost:DEV_HOST_PORT.
DEV_APP_URL=""
# Exemplo para produção Docker em outra porta: WEB_HOST_PORT="3010"; ajuste também
# APP_URL e NEXT_PUBLIC_SITE_URL para "http://localhost:3010".

# ---------- Banco de dados ----------
# Local (docker compose): o serviço `db` é publicado em localhost:55432.
DB_HOST_PORT="55432"
# Se mudar DB_HOST_PORT, ajuste também a porta em DATABASE_URL abaixo.
# Gere uma senha longa sem caracteres que precisem de URL-encode e coloque o mesmo valor nos dois campos:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://spm:SUA_SENHA@localhost:55432/spmnacional?schema=public"
DB_POOL_MAX="5"
DATABASE_CONNECTION_TIMEOUT_MS="5000"
DATABASE_QUERY_TIMEOUT_MS="10000"
# Em um volume existente, preserve a senha atual: alterar POSTGRES_PASSWORD aqui
# não modifica a senha já gravada no Postgres.

# ---------- Segurança ----------
# Segredo usado para assinar tokens de sessão, convite e confirmação.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""

# Somente configure após confirmar quantos endereços de proxies confiáveis
# aparecem à direita no X-Forwarded-For. Vazio = não confiar nesse cabeçalho.
# 0 usa o endereço mais à direita; 1 pula um proxy à direita, e assim por diante.
TRUSTED_PROXY_HOPS=""

# Chave AES-256-GCM (32 bytes em base64) que cifra os dados pessoais do módulo
# de atendimentos. Perder esta chave torna os dados cifrados irrecuperáveis.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# ---------- Conta inicial (usada só pelo seed explícito) ----------
# Para primeira carga de demonstração em banco vazio: bun run setup, depois bun run db:seed.
# Reexecutar o seed sobrescreve conteúdo e permissões existentes.
# Autorize uma conta real do Workspace; o seed não cria senha de acesso.
SEED_ADMIN_NAME="Administrador do SPM"
SEED_ADMIN_EMAIL="admin@spmnacional.org.br"
# Não há login por senha. Use e-mail do domínio Workspace configurado.

# ---------- E-mail (Google Workspace / SMTP) ----------
# Com Google Workspace, use uma Senha de App da conta institucional
# ou o SMTP relay do Workspace. Deixe vazio para desativar o envio:
# o sistema registra a mensagem no banco e apenas não notifica por e-mail.
# Exemplo quando habilitar: smtp.gmail.com; configure host/usuário/senha juntos.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SPM Nacional <contato@spmnacional.org.br>"
# Para onde vão as notificações de novas mensagens do Fale Conosco.
MAIL_NOTIFY_TO="contato@spmnacional.org.br"

# ---------- Login com Google Workspace (OAuth 2.0) ----------
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI autorizada: {APP_URL}/api/auth/google/callback
# ÚNICO método na nuvem. Local sem credenciais e sem modo de teste fica indisponível;
# em GCP a inicialização/deploy recusa credenciais/domínio ausentes.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Obrigatório quando OAuth está habilitado. Exemplo: spmnacional.org.br.
GOOGLE_OAUTH_ALLOWED_DOMAIN=""
# Só definir true após o administrador exigir 2FA para TODOS os usuários do site
# no console Workspace. É uma declaração operacional, não uma checagem de MFA pelo OAuth.
GOOGLE_WORKSPACE_MFA_ENFORCED="false"

# ---------- Exceção explícita para testes SOMENTE em localhost ----------
# Não habilitar em servidor público, túnel, proxy público ou ambiente com dados reais.
# Exige DEPLOYMENT_TARGET=local, APP_URL loopback e OAuth desativado.
# Selecione o ID exato de uma conta ATIVO já cadastrada; não cria usuários/permissões.
LOCAL_TEST_AUTH_ENABLED="false"
LOCAL_TEST_AUTH_USER_ID=""

# ---------- Tradução pública (português -> inglês, francês, espanhol, árabe) ----------
# False não faz chamadas pagas. Habilitar API/IAM e escolher quota antes de ativar.
TRANSLATION_ENABLED="false"
GOOGLE_CLOUD_PROJECT=""
TRANSLATION_LOCATION="global"
# Limite de caracteres de origem por dia UTC, somando todos os idiomas.
# Zero impede novas traduções, mas permite reutilizar as já salvas.
TRANSLATION_DAILY_CHARACTER_LIMIT="50000"

# ---------- Agenda via Google Calendar ----------
# Calendário público da organização + chave de API restrita à Calendar API.
# Vazio = a agenda usa apenas os eventos cadastrados no painel.
GOOGLE_CALENDAR_ID=""
GOOGLE_CALENDAR_API_KEY=""

# ---------- Armazenamento de arquivos ----------
# "local" grava em disco (bom para desenvolvimento e VPS);
# "gcs" grava no Cloud Storage (produção no GCP).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
GCS_BUCKET=""
# Em Cloud Run a autenticação é automática pela conta de serviço;
# fora dele, aponte para o arquivo de credenciais.
GOOGLE_APPLICATION_CREDENTIALS=""

# ---------- Operação ----------
# Token do endpoint de sincronização da agenda (Cloud Scheduler chama com ele).
# Obrigatório no Docker Compose. Gere um valor próprio, diferente de AUTH_SECRET:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
CRON_SECRET=""

# ---------- Bootstrap de produção (execução única, não colocar no Cloud Run) ----------
# bun run db:bootstrap — cria apenas perfis/permissões e uma conta, sem conteúdo demo.
# Preferir variável na sessão operacional protegida, removida após concluir.
BOOTSTRAP_ADMIN_NAME="Administrador do SPM"
BOOTSTRAP_ADMIN_EMAIL=""
# O bootstrap cadastra o e-mail Workspace ativo, sem senha e sem login alternativo.
# Analytics opcional: requer ID de medição real e consentimento explícito do visitante.
# Desative Enhanced Measurement (incluindo histórico, formulários e cliques) na propriedade GA4.
ANALYTICS_ENABLED=false
GA_MEASUREMENT_ID=
GA_ENHANCED_MEASUREMENT_DISABLED=false
