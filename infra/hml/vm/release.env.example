# Root-only /opt/spm-hml/release.env. Build and push on the workstation/CI.
# Use the actual digest from Artifact Registry; never latest for application releases.
APP_IMAGE=southamerica-east1-docker.pkg.dev/PROJECT/spm-hml-docker/site@sha256:REPLACE_WITH_64_HEX
MIGRATOR_IMAGE=southamerica-east1-docker.pkg.dev/PROJECT/spm-hml-docker/migrate@sha256:REPLACE_WITH_64_HEX
POSTGRES_IMAGE=postgres:18.6-alpine
CADDY_IMAGE=caddy:2-alpine
