# Root-only /opt/spm-hml/config.env. This file contains no secrets.
HML_DOMAIN=spm-hml-IP-COM-HIFENS.sslip.io
HML_BASIC_AUTH_USER=hml
GOOGLE_OAUTH_ALLOWED_DOMAIN=
# Global policy: true only after the Workspace administrator actually enforces 2FA.
GOOGLE_WORKSPACE_MFA_ENFORCED=false
# HML only: while global policy is false, exactly one real Workspace account,
# with individual 2FA confirmed by the responsible administrator, is allowed.
# Both fields must be identical; comma-separated lists and additional users are rejected.
GOOGLE_OAUTH_ALLOWED_EMAILS=
GOOGLE_WORKSPACE_MFA_CONFIRMED_EMAILS=
# In the single-account exception, bootstrap must use this exact allowed email.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrador SPM HML
# Translation requires enabled API/custom IAM; 5,000 source chars/day UTC.
TRANSLATION_ENABLED=true
TRANSLATION_DAILY_CHARACTER_LIMIT=5000
# Configure SMTP together; leave all fields empty while unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
MAIL_FROM=
MAIL_NOTIFY_TO=
# Public Calendar only. A matching API key is retrieved from Secret Manager.
GOOGLE_CALENDAR_ID=
# GA4 opcional, desativado até existir ID real e Enhanced Measurement desativado.
ANALYTICS_ENABLED=false
GA_MEASUREMENT_ID=
GA_ENHANCED_MEASUREMENT_DISABLED=false
