{
    "name": "spmnacional-front",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --serve-path /spmnacional_front/",
        "build": "ng build --base-href /spmnacional_front/",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr:spmnacional_front": "node dist/spmnacional_front/server/server.mjs",
        "preview": "node dist/spmnacional_front/server/server.mjs",
        "deploy": "ng deploy --base-href=/spmnacional_front/",
        "format": "npx prettier . --write"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "npm@10.9.2",
    "dependencies": {
        "@angular/common": "^21.2.19",
        "@angular/compiler": "^21.2.19",
        "@angular/core": "^21.2.19",
        "@angular/forms": "^21.2.19",
        "@angular/platform-browser": "^21.2.19",
        "@angular/platform-server": "^21.2.19",
        "@angular/router": "^21.2.19",
        "@angular/ssr": "^21.2.19",
        "express": "^5.1.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.19",
        "@angular/cli": "^21.2.19",
        "@angular/compiler-cli": "^21.2.19",
        "@types/express": "^5.0.1",
        "@types/node": "^20.17.19",
        "angular-cli-ghpages": "^3.1.0",
        "jsdom": "^27.1.0",
        "prettier": "3.8.1",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    },
    "overrides": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "picomatch": "^4.0.4",
        "ajv": "^8.18.0"
    }
}
