// =========================================================
// SPM Nacional — modelo de dados
//
// Convenções:
// - Identificadores em cuid(), nomes de campo em inglês, valores de enum em
//   português (aparecem na interface).
// - Todo conteúdo público tem status e data de publicação, para permitir
//   rascunho, revisão e agendamento.
// - O módulo de atendimentos guarda dados pessoais cifrados pela aplicação
//   (AES-256-GCM). Ver lib/server/crypto.ts.
// =========================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// Enums
// ---------------------------------------------------------

enum UserStatus {
  ATIVO
  INATIVO
  PENDENTE
}

enum AuditLevel {
  INFO
  ALERTA
  CRITICO
}

enum PostStatus {
  RASCUNHO
  REVISAO
  AGENDADO
  PUBLICADO
}

enum MediaKind {
  IMAGEM
  DOCUMENTO
  OUTRO
}

enum EditalStatus {
  ABERTO
  EM_ANALISE
  ENCERRADO
}

enum DocumentoCategoria {
  INSTITUCIONAL
  ASSEMBLEIAS
  NOTAS_PUBLICAS
  FORMACAO
  RELATORIOS
}

enum Regiao {
  NORTE
  NORDESTE
  CENTRO_OESTE
  SUDESTE
  SUL
}

enum ContactStatus {
  NOVA
  EM_ATENDIMENTO
  RESPONDIDA
  ARQUIVADA
}

enum AgendaSource {
  MANUAL
  GOOGLE_CALENDAR
}

enum AtendimentoStatus {
  ABERTO
  EM_ACOMPANHAMENTO
  ENCAMINHADO
  ENCERRADO
}

enum FaixaEtaria {
  CRIANCA
  ADOLESCENTE
  JOVEM
  ADULTO
  IDOSO
  NAO_INFORMADO
}

enum Genero {
  FEMININO
  MASCULINO
  OUTRO
  NAO_INFORMADO
}

enum Necessidade {
  ACOLHIDA
  DOCUMENTACAO
  TRABALHO
  MORADIA
  SAUDE
  EDUCACAO
  JURIDICO
  ALIMENTACAO
  LINGUA_PORTUGUESA
  REUNIAO_FAMILIAR
  VIOLENCIA
  TRAFICO_DE_PESSOAS
  OUTRO
}

// ---------------------------------------------------------
// Autenticação, perfis e auditoria
// ---------------------------------------------------------

model Permission {
  key   String @id
  label String
  hint  String
  order Int    @default(0)

  roles RolePermission[]
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String  @unique
  description String
  /// Perfil de sistema não pode ser removido pela interface.
  system      Boolean @default(false)
  order       Int     @default(0)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  initials String

  /// Nulo quando a conta só entra por Google Workspace.
  passwordHash String?
  /// `sub` do Google, preenchido no primeiro login OAuth.
  googleSub    String? @unique

  roleId     String
  role       Role      @relation(fields: [roleId], references: [id])
  regionalId String?
  regional   Regional? @relation(fields: [regionalId], references: [id])

  status             UserStatus @default(PENDENTE)
  mfaRequired        Boolean    @default(false)
  mustChangePassword Boolean    @default(false)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastAccessAt     DateTime?

  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  resetTokenHash String?   @unique
  resetExpiresAt DateTime?

  sessions            Session[]
  auditEntries        AuditLog[]
  posts               Post[]
  uploads             Media[]
  assignedMessages    ContactMessage[]
  atendimentosAbertos Atendimento[]    @relation("AtendimentoAutor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([regionalId])
  @@index([status])
  @@index([inviteExpiresAt])
  @@index([resetExpiresAt])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// Contador compartilhado entre instâncias para limitar abuso em rotas públicas.
/// A chave é um HMAC: IP e e-mail nunca são gravados aqui em texto claro.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model AuditLog {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorLabel   String
  action       String
  target       String
  level        AuditLevel @default(INFO)
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime   @default(now())
  /// Marca o momento em que identificadores e metadados pessoais foram removidos.
  anonymizedAt DateTime?

  @@index([createdAt])
  @@index([createdAt, anonymizedAt])
  @@index([userId])
  @@index([level])
  @@index([action])
}

// ---------------------------------------------------------
// Conteúdo editorial
// ---------------------------------------------------------

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String @unique
  order Int    @default(0)

  posts Post[]
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String @unique

  posts PostTag[]
}

model Post {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  excerpt String
  /// Corpo em Markdown simplificado (parágrafos, ##, listas, > citação).
  content String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  coverUrl     String?
  coverMediaId String?
  coverMedia   Media?  @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)

  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Assinatura exibida no site — pode ser uma equipe, não só uma pessoa.
  authorName String

  status      PostStatus @default(RASCUNHO)
  publishedAt DateTime?
  highlight   Boolean    @default(false)
  views       Int        @default(0)

  tags PostTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([highlight])
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Media {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  kind         MediaKind @default(OUTRO)
  /// Caminho público servido pela aplicação ou URL absoluta (GCS).
  url          String
  /// Chave interna no provedor de armazenamento.
  storageKey   String    @unique
  width        Int?
  height       Int?
  alt          String?

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  posts      Post[]
  editais    Edital[]
  documentos Documento[]
  materiais  SemanaMaterial[]

  createdAt DateTime @default(now())

  @@index([kind])
  @@index([createdAt])
}

model Edital {
  id           String       @id @default(cuid())
  code         String       @unique
  slug         String       @unique
  title        String
  description  String
  status       EditalStatus @default(ABERTO)
  /// Texto exibido ("Inscrições até 30 de setembro de 2026").
  deadlineText String
  deadlineAt   DateTime?
  scope        String

  fileMediaId String?
  fileMedia   Media?  @relation(fields: [fileMediaId], references: [id], onDelete: SetNull)
  fileUrl     String?

  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Testemunho {
  id         String  @id @default(cuid())
  text       String
  /// Pode ser um pseudônimo quando a pessoa pede anonimato.
  personName String
  origin     String
  initials   String
  photoUrl   String?

  /// Registro do consentimento — exigência da nossa política editorial e da LGPD.
  consent     Boolean  @default(false)
  consentNote String?
  anonymized  Boolean  @default(false)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Documento {
  id       String             @id @default(cuid())
  title    String
  category DocumentoCategoria
  /// Linha de metadados exibida ("PDF · 1,2 MB · Atualizado em 2023").
  meta     String
  icon     String             @default("fa-file-lines")

  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  fileUrl String?

  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
}

model Regional {
  id          String   @id @default(cuid())
  slug        String   @unique
  uf          String
  name        String
  region      Regiao
  description String
  /// Frentes prioritárias da equipe.
  focus       String[]

  address String?
  city    String?
  phone   String?
  email   String?

  active Boolean @default(true)
  order  Int     @default(0)

  users        User[]
  atendimentos Atendimento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region, order])
}

// ---------------------------------------------------------
// Semana do Migrante
// ---------------------------------------------------------

model SemanaEdicao {
  id        String    @id @default(cuid())
  ano       Int       @unique
  slug      String    @unique
  edicao    String
  tema      String
  lema      String
  periodo   String
  startsOn  DateTime?
  endsOn    DateTime?
  coverUrl  String?
  /// Texto de abertura em Markdown simplificado.
  resumo    String
  objetivos String[]
  citacao   String?
  published Boolean   @default(true)

  materiais   SemanaMaterial[]
  programacao SemanaPrograma[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SemanaMaterial {
  id       String       @id @default(cuid())
  edicaoId String
  edicao   SemanaEdicao @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  icon     String
  title    String
  meta     String
  mediaId  String?
  media    Media?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  fileUrl  String?
  order    Int          @default(0)

  @@index([edicaoId, order])
}

model SemanaPrograma {
  id       String       @id @default(cuid())
  edicaoId String
  edicao   SemanaEdicao @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  dia      String
  title    String
  text     String
  order    Int          @default(0)

  @@index([edicaoId, order])
}

// ---------------------------------------------------------
// Agenda (manual ou sincronizada do Google Calendar)
// ---------------------------------------------------------

model AgendaEvent {
  id            String       @id @default(cuid())
  googleEventId String?      @unique
  calendarId    String?
  title         String
  description   String?
  location      String?
  url           String?
  startsAt      DateTime
  endsAt        DateTime
  allDay        Boolean      @default(false)
  source        AgendaSource @default(MANUAL)
  published     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([published, startsAt])
}

// ---------------------------------------------------------
// Contato, boletim e configurações
// ---------------------------------------------------------

model ContactMessage {
  id       String        @id @default(cuid())
  name     String
  email    String
  phone    String?
  city     String?
  subject  String
  language String        @default("Português")
  message  String
  status   ContactStatus @default(NOVA)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  internalNote String?
  respondedAt  DateTime?

  ip          String?
  userAgent   String?
  /// Todos os campos pessoais desta linha já estão cifrados com AES-256-GCM.
  encryptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([encryptedAt])
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  confirmed        Boolean   @default(false)
  confirmTokenHash String?   @unique
  confirmExpiresAt DateTime?
  source           String    @default("site")
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?

  @@index([confirmed])
  @@index([createdAt])
  @@index([confirmExpiresAt])
  @@index([unsubscribedAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Atendimentos (dados pessoais — acesso restrito)
//
// Princípio de minimização: só o mínimo necessário é guardado, e o que
// identifica a pessoa fica cifrado em repouso. O código pseudônimo é o que
// circula no dia a dia da equipe.
// ---------------------------------------------------------

model Atendimento {
  id     String @id @default(cuid())
  codigo String @unique

  regionalId String
  regional   Regional @relation(fields: [regionalId], references: [id])

  /// Cifrados com AES-256-GCM pela aplicação (lib/server/crypto.ts).
  nomeEncrypted    String?
  contatoEncrypted String?

  faixaEtaria  FaixaEtaria   @default(NAO_INFORMADO)
  genero       Genero        @default(NAO_INFORMADO)
  paisOrigem   String?
  idiomas      String[]
  chegadaAno   Int?
  necessidades Necessidade[]

  /// Orientação da equipe: não registrar situação documental nem dado de saúde
  /// que não seja indispensável ao encaminhamento.
  observacoes String?

  status AtendimentoStatus @default(ABERTO)

  abertoPorId String?
  abertoPor   User?   @relation("AtendimentoAutor", fields: [abertoPorId], references: [id], onDelete: SetNull)

  encaminhamentos AtendimentoEncaminhamento[]

  abertoEm     DateTime  @default(now())
  encerradoEm  DateTime?
  /// Data de expurgo automático — política de retenção.
  retencaoAte  DateTime
  /// Preenchido uma única vez pelo expurgo para impedir reprocessamento.
  anonymizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionalId, status])
  @@index([abertoEm])
  @@index([retencaoAte])
  @@index([retencaoAte, anonymizedAt])
  @@index([updatedAt, anonymizedAt])
}

model AtendimentoEncaminhamento {
  id            String      @id @default(cuid())
  atendimentoId String
  atendimento   Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  orgao         String
  descricao     String
  encaminhadoEm DateTime    @default(now())
  registradoPor String?

  @@index([atendimentoId])
}
